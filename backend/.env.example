# ---------------------------------------------------------------------------
# StudyHub API – configuration (copy to .env and adjust)
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development
# HTTP port and bind address
PORT=4000
HOST=0.0.0.0
# Public base URL of the API, used to build absolute media URLs (/uploads/...).
# Must be reachable by the phones (e.g. http://192.168.1.20:4000 on a LAN, https://api.example.com in prod).
PUBLIC_URL=http://localhost:4000

# PostgreSQL connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/studyhub
# Set to true for managed databases requiring TLS (Render, Railway, Neon...)
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Run pending migrations automatically when the server starts (true/false)
AUTO_MIGRATE=false

# Auth – JWT_SECRET is required (>= 16 chars). Generate one: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (jsonwebtoken syntax: 15m, 1h...)
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime in days (opaque tokens, rotated on each refresh)
REFRESH_TOKEN_TTL_DAYS=30
# bcrypt cost factor (4-15)
BCRYPT_ROUNDS=12

# CORS: "*" or a comma-separated list of origins (mobile apps do not need CORS)
CORS_ORIGINS=*
# Express "trust proxy" setting: false, true, a hop count (1) or a subnet list. Use 1 behind Render/Railway/nginx.
TRUST_PROXY=false

# Rate limiting (per IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Stricter limiter for register/login/refresh/forgot/reset
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# local (default) or s3. If S3_BUCKET is set and STORAGE_DRIVER is empty, s3 is used.
STORAGE_DRIVER=local
# Local driver: directory served at /uploads
UPLOAD_DIR=uploads
# Temporary directory for incoming uploads (defaults to the OS temp dir)
TMP_DIR=
# S3-compatible driver (AWS S3, Cloudflare R2, Backblaze B2, MinIO, Scaleway...)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Public base URL of the bucket/CDN (e.g. https://cdn.example.com). Defaults to S3_ENDPOINT/S3_BUCKET.
S3_PUBLIC_URL=

# ffmpeg binaries (video thumbnails, duration, dimensions)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---------------------------------------------------------------------------
# E-mail (password reset codes). When SMTP_HOST is empty, codes are logged to the console.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StudyHub <no-reply@studyhub.app>

# ---------------------------------------------------------------------------
# Optional: Redis. Enables the BullMQ video queue (consumed by `npm run worker`)
# and the Socket.IO Redis adapter (several API instances). Without Redis, videos
# are transcoded by an in-process queue inside the API.
# ---------------------------------------------------------------------------
REDIS_URL=
# With REDIS_URL set, also run a video worker inside the API process (true/false, default false)
WORKER_IN_API=false

# ---------------------------------------------------------------------------
# Video pipeline (H.264/AAC MP4, faststart)
# ---------------------------------------------------------------------------
# false = no background transcoding: videos are only remuxed at upload and published immediately
VIDEO_TRANSCODE=true
# Parallel transcodes per process
VIDEO_CONCURRENCY=1
# Maximum size of the shorter side (720 = 720p)
VIDEO_MAX_HEIGHT=720

# ---------------------------------------------------------------------------
# Push notifications (Firebase Cloud Messaging HTTP v1; iOS through APNs-via-FCM).
# Without credentials, push is disabled (no-op, logged at debug level).
# ---------------------------------------------------------------------------
# Defaults to project_id from the service account
FCM_PROJECT_ID=
# Service-account JSON, raw or base64-encoded (takes precedence over the file)
FCM_CREDENTIALS_JSON=
# ...or the path to the service-account JSON file
FCM_CREDENTIALS_FILE=
# Override only for testing/mocking
FCM_API_URL=https://fcm.googleapis.com

# ---------------------------------------------------------------------------
# Content filter (posts, comments, messages, bios, names, communities, series, events)
# ---------------------------------------------------------------------------
# mask (replace blocked words with *), reject (400 VALIDATION_ERROR) or off
CONTENT_FILTER=mask
# Extra blocked words, comma separated
CONTENT_FILTER_WORDS=
# Use the built-in FR/EN list (true/false)
CONTENT_FILTER_DEFAULTS=true

# ---------------------------------------------------------------------------
# Optional: npm run seed:admin creates ONE verified account from these values
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=StudyHub
ADMIN_ROLE=creator
ADMIN_UNIVERSITY=
