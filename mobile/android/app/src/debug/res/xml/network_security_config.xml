<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG builds only: allow cleartext HTTP to the local dev API
     (Android emulator host 10.0.2.2, localhost, and LAN IPs of a dev machine). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
