{
  "name": "StudyHub",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output /tmp/index.android.bundle",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output /tmp/main.jsbundle",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "6.6.1",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.11.0",
    "@tanstack/react-query": "4.36.1",
    "react": "18.2.0",
    "react-native": "0.72.17",
    "react-native-image-picker": "7.1.2",
    "react-native-keychain": "8.2.0",
    "react-native-linear-gradient": "2.8.3",
    "react-native-safe-area-context": "4.7.4",
    "react-native-screens": "3.27.0",
    "react-native-vector-icons": "10.2.0",
    "react-native-video": "5.2.1",
    "socket.io-client": "4.7.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.12",
    "@testing-library/react-native": "12.4.3",
    "@tsconfig/react-native": "^3.0.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.0.24",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-native-video": "5.0.20",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "^0.76.9",
    "patch-package": "8.0.0",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
